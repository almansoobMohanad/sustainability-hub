{
  "name": "sustainability-hub",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @hub/db db:generate",
    "db:migrate": "pnpm --filter @hub/db db:migrate",
    "db:studio": "pnpm --filter @hub/db db:studio"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.18.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.18.0",
  "devDependencies": {
    "turbo": "^2.11.11",
    "typescript": "~6.0.3"
  }
}
