# Copy to .env (git-ignored) only if you need to override the defaults.
# In development every value has a sensible default, so no .env is needed.
# In production (NODE_ENV=production) the values marked REQUIRED have no default.

# Postgres connection (REQUIRED in production). Default: the Docker database
DATABASE_URL=postgres://hub:hub@127.0.0.1:5432/sustainability_hub

# Where the API listens. Default: 127.0.0.1:3000 (this PC only)
HOST=127.0.0.1
PORT=3000

# Address people open the app at (REQUIRED in production). Email links point here.
APP_URL=http://localhost:5174

# Signs session cookies and tokens (REQUIRED in production, 32+ random characters,
# e.g. `openssl rand -base64 48`). Never commit a real one.
BETTER_AUTH_SECRET=development-only-secret-never-use-this-in-production

# Mail server (REQUIRED in production). Default: Mailpit from docker-compose.yml
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM=Sustainability Hub <no-reply@sustainability-hub.local>

# Reverse proxies in front of the API that add X-Forwarded-For.
# Default: 1 in development (Vite), 0 in production.
TRUST_PROXY_HOPS=1

# Reject passwords from known data breaches (needs internet). Default: true
CHECK_BREACHED_PASSWORDS=true

# "Continue with Google" (optional; set both or neither). From Google Cloud Console:
# APIs & Services > Credentials > OAuth client ID (type "Web application"), with the
# redirect URL <APP_URL>/api/auth/callback/google. Never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
