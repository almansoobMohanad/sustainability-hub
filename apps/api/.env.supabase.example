# Settings for `pnpm dev:supabase`: the same app, but with the Supabase (cloud) database.
# Copy this file to .env.supabase (git-ignored, next to this file) and fill it in.
# Values here override .env; everything else (e.g. Google sign-in) still comes from .env.
# `pnpm dev` keeps using the local Docker database. Tests always use a local test database.

# Supabase dashboard > your project > Connect > "Session pooler" (port 5432, works on IPv4).
# Not "Direct connection" (IPv6 only) and not "Transaction pooler" (port 6543): the API refuses those.
# Replace [YOUR-PASSWORD] with the database password. If it contains characters such as @ : / ? # %,
# write them URL-encoded (e.g. @ as %40), or reset it in Supabase to one with letters and digits only.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres

# Supabase's CA certificate, so the connection is encrypted and checked:
# Project Settings > Database > SSL Configuration > Download certificate.
# Save it next to this file as supabase-ca.crt (git-ignored).
DATABASE_CA_CERT=./supabase-ca.crt

# Connections the API keeps open. Supabase's free plan allows only a few through the pooler.
DATABASE_POOL_MAX=5
