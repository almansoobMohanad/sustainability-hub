{
  "name": "@hub/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --watch-preserve-output --import tsx src/index.ts",
    "dev:supabase": "node ../../scripts/with-env-file.mjs .env.supabase node --watch --watch-preserve-output --import tsx src/index.ts",
    "build": "tsdown",
    "start": "node dist/index.mjs",
    "build:vercel": "tsdown --config tsdown.vercel.config.ts",
    "vercel:output": "tsx src/tools/vercel-output.ts",
    "db:deploy": "tsx src/tools/migrate.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "auth:schema": "auth generate --config src/auth/cli-config.ts --output ../../packages/db/src/schema/auth.ts --yes && node scripts/finish-auth-schema.mjs",
    "db:latency": "tsx src/tools/db-latency.ts",
    "db:latency:supabase": "node ../../scripts/with-env-file.mjs .env.supabase tsx src/tools/db-latency.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@hono/zod-openapi": "^1.6.3",
    "@hub/db": "workspace:*",
    "@hub/shared": "workspace:*",
    "@scalar/hono-api-reference": "^0.12.20",
    "@vercel/functions": "3.11.3",
    "better-auth": "^1.7.25",
    "hono": "^4.13.18",
    "nodemailer": "^10.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "auth": "^1.7.25",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.1"
  }
}
