# Copy to .env.local (git-ignored) only if you need to override the defaults.
# Address of the public website; "Back to website" links here. Default in development:
# http://localhost:5173/. A production build without it shows no website link.
# Docker: docker build --build-arg VITE_SITE_URL=https://example.com/ .
VITE_SITE_URL=http://localhost:5173/
